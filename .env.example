# Copy to .env if you want defaults other than these (the Makefile reads it when present).
# Command-line flags override these; these override the built-in defaults.
LOGSUM_LOG_LEVEL=WARNING
LOGSUM_TOP=10
# exact keeps every latency per path; histogram keeps fixed-size buckets
LOGSUM_ESTIMATOR=exact
LOGSUM_BUCKET_MS=5
LOGSUM_MAX_LATENCY_MS=10000
